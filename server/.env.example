# ===========================
# CryptoMart Backend Config
# ===========================

# Server
PORT=3001
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DB_PATH=./server/data/cryptomart.db

# File uploads
UPLOAD_DIR=./server/uploads
FRONTEND_URL=http://localhost:5173

# ===========================
# BTCPay Server (Bitcoin Payments)
# ===========================
# Set up your own BTCPay Server: https://docs.btcpayserver.org/
BTCPAY_URL=https://your-btcpay-instance.com
BTCPAY_API_KEY=your-btcpay-api-key
BTCPAY_STORE_ID=your-btcpay-store-id
BTCPAY_WEBHOOK_SECRET=your-webhook-secret

# ===========================
# FedEx API (Shipping)
# ===========================
# Register at: https://developer.fedex.com/
# Use sandbox URL for testing: https://apis-sandbox.fedex.com
FEDEX_API_URL=https://apis-sandbox.fedex.com
FEDEX_CLIENT_ID=your-fedex-client-id
FEDEX_CLIENT_SECRET=your-fedex-client-secret
FEDEX_ACCOUNT_NUMBER=your-fedex-account-number

# ===========================
# Pricing Defaults
# ===========================
DEFAULT_TAX_RATE=0.10
DEFAULT_PROFIT_MARGIN=0.20
DEFAULT_PACKAGING_COST=5.00
ESCROW_RELEASE_DELAY_HOURS=48
ESCROW_DISPUTE_WINDOW_HOURS=168
